    "#| label: load-data-sql-bulan\n",
    "\n",
    "import pandas as pd\n",
    "import re\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "dfbulan = pd.read_csv(\"atikah/4.dat\", \n",
    "                 sep=\";\", \n",
    "                 header = None,\n",
    "                 skiprows=37,\n",
    "                 names=[\"datetimes_utc\", \"datetime_local\", \"temp_c\", \"counts\", \"hz\", \"mpsas\"]\n",
    ")\n",
    "dfbulan.head()"
   ]
  },
