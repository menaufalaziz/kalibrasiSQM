        "ax2.set_title(\"SQM Bulan\", fontsize=11)\n",
        "ax2.set_ylabel(\"MPSAS (mag/arcsec^2)\")\n",
        "ax2.invert_yaxis()\n",
        "ax2.xaxis.set_major_formatter(mdates.DateFormatter(\"%H:%M\"))\n",
        "\n",
